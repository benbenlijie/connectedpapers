# Copy to scripts/deploy.env and fill in your own values.
# scripts/deploy.env is git-ignored — keep host names and paths out of the repo.
#
#   cp scripts/deploy.env.example scripts/deploy.env

# ssh host or alias to deploy to (required)
REMOTE=my-server

# remote install directory, owned by the deploy user
DIR=/opt/citeduo

# frontend base path; must match the sub-path your reverse proxy serves
# use / when the app owns the domain root
VITE_BASE=/

# systemd unit that runs `bun run server` on the remote
SERVICE=citeduo

# health-checked URL; leave empty to skip the check
PUBLIC_URL=

# remote bun binary, used when bun is not on a non-interactive ssh PATH
REMOTE_BUN=/root/.bun/bin/bun
