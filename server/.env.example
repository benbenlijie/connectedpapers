# 复制为 server/.env 后按需填写：cp server/.env.example server/.env
# （scripts/setup.sh 会自动完成这一步）

# Semantic Scholar API Key（可选）。留空则使用共享配额；填写后为独立 1 req/s。
# 申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 联系邮箱：用于 API User-Agent（OpenAlex 礼貌通道）。建议填真实邮箱。
CONTACT_EMAIL=you@example.com

# OpenAlex API key（可选）。配置后摆脱匿名搜索限流，获得更高配额。
# 申请：https://openalex.org/rest-api
OPENALEX_API_KEY=

# 上游请求最小间隔（毫秒，可选）。S2 未配置 key 时默认 1000ms，有 key 默认 100ms；OpenAlex 默认 200ms。
# S2_MIN_INTERVAL_MS=1000
# OPENALEX_MIN_INTERVAL_MS=200

# 服务端口，默认 8787。
PORT=8787

# 公网部署（可选）。设置后所有请求都需要口令；本地留空则完全不鉴权。
# 首次用 https://你的域名/?token=你的口令 打开一次，之后写入 Cookie。
ACCESS_TOKEN=
# 若在反向代理（nginx/Caddy）之后，设为 1 以信任 X-Forwarded-For 来识别真实 IP。
TRUST_PROXY=0
# 每 IP 每分钟 /api/* 请求上限（0 关闭）。默认 120。
RATE_LIMIT_PER_MIN=120

# 相关性扩展（多源相关边）调优，可选。
# RELATED_RECOMMEND_LIMIT=10   # S2 语义推荐取前 N
# RELATED_NODE_BUDGET=15       # 相关来源额外加入的节点上限
# COUPLING_MIN=2               # 文献耦合最小共享参考文献数
# OPENALEX_RELATED_LIMIT=10    # OpenAlex 相关作品取前 N
# EMBEDDING_BATCH=100          # 每次构建最多补取的向量数
# EMBEDDING_K=5                # 语义近邻 k
# EMBEDDING_MIN_SIM=0.8        # 语义边的最小余弦相似度

# 「两篇论文如何关联」检索（/api/connect）调优，可选。
# 顺序：先查本地已存关系 → 再双向联网扩展 → 仍无结构关系时回退语义相似度。
# CONNECT_MAX_EXPANSIONS=6         # 联网扩展的批量取数次数上限
# CONNECT_BATCH_SIZE=30            # 每次扩展取多少篇论文
# CONNECT_FRONTIER_LIMIT=60        # 单轮候选前沿上限
# CONNECT_REF_LIMIT=40             # 每篇展开论文保留的参考文献数
# CONNECT_CITE_LIMIT=25            # 每篇展开论文保留的引用者数
# CONNECT_MAX_HOPS=6               # 关联路径最大跳数
# CONNECT_MAX_PATHS=3              # 最多返回几条备选路径
# CONNECT_MAX_MS=25000             # 单次检索墙钟时间上限
# CONNECT_SEMANTIC_MIN_SIM=0.75    # 判定语义关联的最小余弦相似度
# CONNECT_LOCAL_ONLY=1             # 设为 1 完全离线，只走 SQLite 已存关系

# LLM providers（翻译 / AI 辅助）。JSON 数组，数组顺序 = 优先级，失败自动降级到下一个。
# kind: "openai" = OpenAI 兼容 Chat Completions（mtcode / DeepSeek / OpenAI / Ollama 均可用）。
# kind: "browser" = 浏览器内置 Translator API，由前端本地执行，无需 key。
# 未配置时翻译接口返回 LLM_UNAVAILABLE。
# LLM_PROVIDERS=[{"name":"mtcode","kind":"openai","baseUrl":"https://your-mtcode-endpoint/v1","apiKey":"sk-xxx","model":"mtcode/deepseek-flash"},{"name":"browser","kind":"browser"}]
LLM_PROVIDERS=
