# 复制为 server/.env 后按需填写：cp server/.env.example server/.env
# （scripts/setup.sh 会自动完成这一步）

# Semantic Scholar API Key（可选）。留空则使用共享配额；填写后为独立 1 req/s。
# 申请：https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# 联系邮箱：用于 API User-Agent（OpenAlex 礼貌通道）。建议填真实邮箱。
CONTACT_EMAIL=you@example.com

# 服务端口，默认 8787。
PORT=8787

# LLM providers（翻译 / AI 辅助）。JSON 数组，数组顺序 = 优先级，失败自动降级到下一个。
# kind: "openai" = OpenAI 兼容 Chat Completions（mtcode / DeepSeek / OpenAI / Ollama 均可用）。
# kind: "browser" = 浏览器内置 Translator API，由前端本地执行，无需 key。
# 未配置时翻译接口返回 LLM_UNAVAILABLE。
# LLM_PROVIDERS=[{"name":"mtcode","kind":"openai","baseUrl":"https://your-mtcode-endpoint/v1","apiKey":"sk-xxx","model":"mtcode/deepseek-flash"},{"name":"browser","kind":"browser"}]
LLM_PROVIDERS=
